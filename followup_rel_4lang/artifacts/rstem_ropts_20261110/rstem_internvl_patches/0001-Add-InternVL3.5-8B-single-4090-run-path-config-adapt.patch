index 0000000..dfc214d
--- /dev/null
+++ b/01_code/configs/models/internvl3_5_8b_4090.yaml
@@ -0,0 +1,33 @@
+model_id: OpenGVLab/InternVL3_5-8B
+model_family: internvl3_5
+# HF main as of 2025-08-29 (checked 2026-11-08). Language model: Qwen3ForCausalLM.
+revision: 9bb6a56ad9cc69db95e2d4eeb15a52bbcac4ef79
+dtype: bfloat16
+quantization: null
+trust_remote_code: true
+
+# Same backend as the InternVL2.5 runs: no flash-attn install, remote code
+# then sets the language model to eager attention. Qwen runs used SDPA; record
+# this difference in the paper's execution contract.
+attn_implementation: eager
+use_flash_attn: false
+device_strategy: cuda:0
+
+# 448px tiles, at most 7 tiles + thumbnail = 8 x 256 = 2,048 visual tokens,
+# the same visual-token cap as Qwen (max_pixels 2,097,152). The model card
+# default is max_num 12; a max_num 12 subset is a separate sensitivity run.
+processor_profile: internvl_dynamic_448_fixed_2048
+input_size: 448
+min_num: 1
+max_num: 7
+use_thumbnail: true
+vision_token_limit: 2048
+
+# Thinking mode stays off: it is enabled only by the R1 system prompt, and every
+# runner passes the explicit english_fixed system prompt instead.
+prompt_profile: mpr_label_only_v1
+generation:
+  do_sample: false
+  num_beams: 1
+  max_new_tokens: 2
+  temperature: null
